{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow1C interview-register input v1",
  "type": "object",
  "required": ["gate_id", "action", "request"],
  "properties": {
    "gate_id": {"type": "string", "minLength": 8},
    "action": {"enum": ["inspect", "audit", "write"]},
    "request": {"type": "object"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "write"}}},
      "then": {"properties": {"request": {"$ref": "#/$defs/write"}}},
      "else": {"properties": {"request": {"$ref": "#/$defs/inspect"}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "maxLength": 32767},
    "row": {
      "type": "object",
      "required": ["l1_code", "l1_name", "l2_code", "l2_name", "l3_code", "l3_name", "question_id", "question"],
      "properties": {
        "l1_code": {"$ref": "#/$defs/text"}, "l1_name": {"$ref": "#/$defs/text"},
        "l2_code": {"$ref": "#/$defs/text"}, "l2_name": {"$ref": "#/$defs/text"},
        "l3_code": {"$ref": "#/$defs/text"}, "l3_name": {"$ref": "#/$defs/text"},
        "question_id": {"$ref": "#/$defs/text"}, "question": {"$ref": "#/$defs/text"},
        "owner": {"$ref": "#/$defs/text"}, "interviewer": {"$ref": "#/$defs/text"},
        "answer": {"$ref": "#/$defs/text"}, "decision": {"$ref": "#/$defs/text"},
        "requirement": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"}
      },
      "additionalProperties": false
    },
    "patch": {
      "type": "object", "required": ["question_id", "fields"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "fields": {
          "type": "object", "minProperties": 1,
          "properties": {
            "owner": {"$ref": "#/$defs/text"}, "interviewer": {"$ref": "#/$defs/text"},
            "answer": {"$ref": "#/$defs/text"}, "decision": {"$ref": "#/$defs/text"},
            "requirement": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object", "required": ["draft_id", "question_id", "text", "acceptance_criterion"],
      "properties": {
        "draft_id": {"type": "string", "minLength": 1}, "question_id": {"type": "string", "minLength": 1},
        "text": {"$ref": "#/$defs/text"}, "acceptance_criterion": {"$ref": "#/$defs/text"},
        "owner": {"$ref": "#/$defs/text"}, "priority": {"$ref": "#/$defs/text"},
        "implementation": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/text"},
        "status": {"enum": ["Черновик", "Требует согласования"]}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "location": {"$ref": "#/$defs/text"},
        "section": {"$ref": "#/$defs/text"}, "product_release": {"$ref": "#/$defs/text"},
        "checked_at": {"$ref": "#/$defs/text"}, "availability": {"$ref": "#/$defs/text"},
        "conclusion": {"$ref": "#/$defs/text"}, "related_questions": {"$ref": "#/$defs/text"}
      },
      "additionalProperties": false
    },
    "inspect": {
      "type": "object", "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1}, "sheet": {"type": "string", "minLength": 1},
        "offset": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 200}
      },
      "additionalProperties": false
    },
    "write": {
      "type": "object",
      "properties": {
        "source": {"type": "string", "minLength": 1}, "sheet": {"type": "string", "minLength": 1},
        "output_name": {"type": "string", "pattern": "^[^/\\\\:]+\\.xlsx$"},
        "rows": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/row"}},
        "patches": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/patch"}},
        "requirements": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/requirement"}},
        "context": {"type": "object", "maxProperties": 100, "additionalProperties": {"$ref": "#/$defs/text"}},
        "sources": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/source"}},
        "open_questions": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/text"}}
      },
      "additionalProperties": false
    }
  }
}
