{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "gate_id", "operation", "state", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "gate_id": {"type": "string", "minLength": 8},
    "operation": {"type": "string"},
    "requested_operation": {"type": "string"},
    "routing_reason": {"type": "string"},
    "route_origin": {"enum": ["legacy", "structured"]},
    "route_proposal": {"type": "object", "$ref": "route-proposal.schema.json"},
    "route_decision": {"type": "object", "$ref": "route-decision.schema.json"},
    "query_intent": {"enum": ["create", "review", "optimize"]},
    "query_contract_version": {"enum": [0, 1]},
    "query_verification": {"type": "object"},
    "interview_output": {
      "type": "object",
      "required": ["schema_version", "path", "sha256", "document_status", "sheet", "audit"],
      "properties": {
        "schema_version": {"const": 1},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "document_status": {"const": "UNVERIFIED_DRAFT"},
        "sheet": {"type": "string"},
        "audit": {"type": "object"}
      },
      "additionalProperties": true
    },
    "code": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "deprecated": true},
    "project_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "task_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "git_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256, "pattern": "^(?!-)[^\\u0000-\\u001F\\u007F]+$"},
    "work_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "reference_source": {"enum": ["task", "project", "none", "legacy"]},
    "requested_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "reference_kind": {"enum": ["auto", "requirement", "specification"]},
    "registry_resolution": {"type": ["object", "null"]},
    "traceability_mode": {"enum": ["registry", "provisional"]},
    "work_item_exists": {"type": "boolean"},
    "state": {"enum": ["NEEDS_CODE", "NEEDS_INPUT", "NEEDS_CONFIRMATION", "WAITING_USER", "WAITING_BACKGROUND", "READY", "READY_WITH_DEVIATIONS", "BLOCKED", "UNVERIFIED_DRAFT", "COMPLETE", "COMPLETE_WITH_DEVIATIONS", "CONSULTATION_COMPLETE", "DRAFT_COMPLETE", "SUPERSEDED", "NON_COMPLIANT"]},
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"enum": ["process", "registry_bypass", "completion"]},
          "actor": {"type": "string"},
          "reason": {"type": "string"},
          "user_statement": {"type": "string"},
          "scope": {"enum": ["gate", "work-item"]},
          "condition_ids": {"type": "array", "items": {"type": "string"}},
          "waived_conditions": {"type": "array", "items": {"type": "string"}},
          "recorded_at": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "message", "source", "waivable", "blocking"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["work_reference", "registry_traceability", "required_input", "conditional_input", "status", "approval", "rlm_evidence", "diff_evidence", "bsl_evidence", "extension_branch", "path_safety", "publication", "external_confirmation"]},
          "message": {"type": "string"},
          "source": {"type": "string"},
          "waivable": {"type": "boolean"},
          "blocking": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "remaining_blockers": {"type": "array"},
    "compliance": {"enum": ["COMPLIANT", "DEVIATED"]},
    "policy_version": {"type": "integer"},
    "mode": {"enum": ["explore", "draft", "formal"]},
    "mode_selection": {"type": ["object", "null"]},
    "mode_history": {"type": "array", "items": {"type": "object"}},
    "awaiting_user_input": {"type": "boolean"},
    "request_id": {"type": "string"},
    "reference_code": {"type": ["string", "null"]},
    "clarification": {"type": ["object", "null"]},
    "available_actions": {"type": "array"},
    "answers": {"type": "array"},
    "created_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "context_sha256": {"type": "string"},
    "evidence_path": {"type": "string"},
    "completion_record": {"type": "object", "required": ["schema_version", "result", "exit_code", "seal"],
                           "properties": {"schema_version": {"const": 1}, "result": {"type": "object"},
                                          "exit_code": {"type": "integer"}, "seal": {"type": "object"}}},
    "handoff_status": {"enum": ["RECOVERY_REQUIRED", "READY"]},
    "handoff": {"type": "object", "required": ["schema_version", "path", "sha256"],
                "properties": {"schema_version": {"const": 1}, "path": {"type": "string"},
                               "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  },
  "additionalProperties": true
}
