{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "operations": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false, "required": ["target_id", "kind", "value", "basis"],
      "allOf": [{"if": {"properties": {"kind": {"const": "table"}}}, "then": {"properties": {"value": {"type": "array"}}}, "else": {"properties": {"value": {"type": "string"}}}}],
      "properties": {
        "target_id": {"type": "string"}, "kind": {"enum": ["text", "section", "table"]},
        "value": {"oneOf": [{"type": "string", "maxLength": 500000}, {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}]},
        "basis": {"type": "string", "minLength": 1, "maxLength": 8000}
      }
    }}
  }
}
